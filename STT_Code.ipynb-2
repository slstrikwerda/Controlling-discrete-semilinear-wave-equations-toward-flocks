        "id": "iemzlKt0tdMp"
      },
      "outputs": [],
      "source": [
        "def reproduce():\n",
        "    main=run(1.)\n",
        "    fig,axs=plt.subplots(4,2,figsize=(10.4,9.1),sharex='col',layout='constrained')\n",
        "    for col in range(2):\n",
        "        for tt,dat,phase in main['chunks']:\n",
        "            xx,vv,uu=dat[:,:D],dat[:,D:2*D],dat[:,2*D:]\n",
        "            for k in range(D):\n",
        "                axs[0,col].plot(tt,xx[:,k]-np.mean(xx,axis=1),lw=.8,ls=styles[k%4],alpha=.8)\n",
        "                axs[1,col].plot(tt,vv[:,k],lw=.8,ls=styles[k%4],alpha=.8)\n",
        "                axs[2,col].plot(tt,lap(xx)[:,k],lw=.8,ls=styles[k%4],alpha=.8)\n",
        "            axs[3,col].plot(tt,np.max(np.abs(uu),axis=1),'k',lw=1.2)\n",
        "        axs[3,col].axhline(1,color='black',ls='--',lw=1,label='bound M')\n",
        "        for ax in axs[:,col]:\n",
        "            for key in ['T0','T1','T2','T3','T4']:ax.axvline(main[key],color='.55',ls=':',lw=.8)\n",
        "            ax.grid(alpha=.18)\n",
        "        axs[3,col].set_xlabel('Time')\n",
        "    axs[0,0].set_title('Full trajectory');axs[0,1].set_title('Initial phases (expanded)')\n",
        "    axs[0,0].set_ylabel('Position minus mean position')\n",
        "    axs[1,0].set_ylabel('Site velocities');axs[2,0].set_ylabel('Discrete Laplacian');axs[3,0].set_ylabel('Maximum control magnitude')\n",
        "    axs[3,0].legend(loc='best',fontsize=9)\n",
        "    axs[3,1].set_xlim(0,main['T3']+.2)\n",
        "    axs[2,1].set_ylim(-.43,.43)\n",
        "    rows=[]\n",
        "    timestable=[]\n",
        "    for ratio in [.002,.005,.01,.02,.05,.1,.2,.5,1.]:\n",
        "        m=F*(1+ratio); result=run(m)\n",
        "        row={k:float(v) for k,v in result.items() if np.isscalar(v)};row['relative_gap']=ratio\n",
        "        rows.append(row)\n",
        "        print('threshold',ratio,'T',result['T'],'bound',flush=True)\n",
        "        times={'relative_gap': ratio,\n",
        "        'M': m,\n",
        "        'T0': result['T0'],\n",
        "        'T1': result['T1'],\n",
        "        'T2': result['T2'],\n",
        "        'T3': result['T3'],\n",
        "        'T4': result['T4']}\n",
        "        timestable.append(times)\n",
        "\n",
        "    df=pd.DataFrame(timestable)\n",
        "    display(timestable)\n",
        "    fig,ax=plt.subplots(figsize=(7.5,4.2),layout='constrained')\n",
        "    ax.semilogx([r['relative_gap'] for r in rows],[r['T'] for r in rows],'o-',color='#163d73',label='Observed construction time')\n",
        "    ax.set_xlabel(r'Relative threshold gap $(M-F_*)/F_*$');ax.set_ylabel('Steering time');ax.grid(which='both',alpha=.2);ax.legend()\n",
        "\n",
        "    tight=run(1.,tol=2e-12)\n",
        "    verification={\n",
        "     'python_dependencies':{'numpy':np.__version__,'scipy':scipy.__version__,'matplotlib':matplotlib.__version__},\n",
        "     'main':{k:float(v) for k,v in main.items() if np.isscalar(v)},\n",
        "     'tight_tolerance_T_difference':float(abs(main['T']-tight['T'])),\n",
        "     'tight_tolerance_ode_check':float(tight['ode_check']),\n",
        "     'maximum_threshold_control_excess':float(max(r['max_control']-r['M'] for r in rows)),\n",
        "     'minimum_threshold_margin_after_braking':float(min(r['Eh']-r['lap_after_braking'] for r in rows)),\n",
        "     'maximum_threshold_ode_check':float(max(r['ode_check'] for r in rows)),\n",
        "     'maximum_threshold_collapse_spread':float(max(r['collapse_spread'] for r in rows)),\n",
        "     'maximum_threshold_switch_state_jump':float(max(r['max_switch_state_jump'] for r in rows)),\n",
        "     #'maximum_threshold_target_translation_error':float(max(r['target_translation_error'] for r in rows)),\n",
        "     'threshold_study':rows,\n",
        "    }\n",
        "    require(main['max_control']<=1+1e-10,'The main example exceeds M=1')\n",
        "    require(all(r['max_control']<=r['M']+1e-10 and r['Q_collapse']<r['mu_collapse']\n",
        "                and r['Q_target']<r['mu_target'] and r['lap_after_braking']<r['Eh'] for r in rows),\n",
        "                    'A threshold-study control check failed')\n",
        "    tex=r'''For $M=1$, the switching times are $T_0=%.6f$, $T_1=%.6f$, $T_2=%.6f$, $T_3=%.6f$, and $T_4=%.6f$. The last two stages have separate durations $T_3-T_2=%.6f$ and $T_4-T_3=%.6f$. At $T_3$ all positions coincide: the computed spread is $%.2e$, and the common-velocity error is $%.2e$. The sampled maximum control magnitude is $%.6f$; after the first phase it is $%.6f$. The post-braking Laplacian norm is $%.3e$, below the conservative bound $E_h=%.6f$. A separate integration of the planned controls after $T_0$, split at every switching time, has a maximum sampled state error of $%.2e$, evaluated at accepted solver steps and their midpoints. Tightening the relative tolerance to $2\\times10^{-12}$ changes the reported arrival time by $%.2e$. These numerical checks are floating-point diagnostics; the script checks the sufficient inequality for each of the two final stages separately.\n",
        "    '''%(main['T0'],main['T1'],main['T2'],main['T3'],main['T4'],main['tau_collapse'],main['tau_target'],main['collapse_spread'],main['collapse_velocity_error'],#main['target_translation_error'],\n",
        "         main['max_control'],main['max_later_control'],main['lap_after_braking'],main['Eh'],main['ode_check'],verification['tight_tolerance_T_difference'])\n",
        "    print(tex)\n",
        "    import re\n",
        "    print(json.dumps({k:v for k,v in verification.items() if k!='threshold_study'},indent=2))"
      ]
    },
    {
