      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "import numpy as np\n",
        "import scipy\n",
        "from scipy.integrate import solve_ivp\n",
        "import matplotlib\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "id": "_YUt-DJipFMZ"
      },
      "outputs": [],
      "source": [
        "#Set up parameters, but note parts of the code below depend on alpha=beta=1.\n",
        "D=12; h=1/D; alpha=beta=1.; F=2/(3*np.sqrt(3));\n",
        "j=np.arange(D); a=2*np.pi*j/D\n",
        "#x0 and v0 provides initial conditions\n",
        "x0=.04*np.cos(a)+.015*np.sin(2*a)\n",
        "v0=-np.ones(D)/np.sqrt(3)+.12*np.sin(a)\n",
        "#B descripes the target flock\n",
        "B=.008*np.cos(a)\n",
        "styles=['-','--','-.',':']\n",
        "#This function calculates the laplacian\n",
        "def lap(x):return (np.roll(x,1,axis=-1)+np.roll(x,-1,axis=-1)-2*x)/h**2\n",
        "def f(v):return v-v**3\n",
        "def energy(x,v):\n",
        "    # The difference form avoids subtracting large translation-dependent terms.\n",
        "    return float(.5*np.sum(v*v)+.5/h**2*np.sum((np.roll(x,1)-x)**2))\n",
        "\n",
        "def require(condition,message):\n",
        "    \"\"\"Keep numerical verification active even with Python's -O option.\"\"\"\n",
        "    if not condition:\n",
        "        raise RuntimeError(message)\n",
        "\n",
        "def setup(M):\n",
        "    if not np.isscalar(M) or not np.isrealobj(M) or not np.isfinite(M) or M<=F:\n",
        "        raise ValueError(f'M must be finite and strictly larger than F={F}')\n",
        "    if (alpha,beta)!=(1.,1.):\n",
        "        raise ValueError('This script implements only alpha=beta=1')\n",
        "    gamma=2*max(1,1/M); a1=1/gamma; a2=gamma\n",
        "    # The outer 1/2 already guarantees Eh < M/2:\n",
        "    # Eh <= (M/2)*(1+8/h**2)/(13+8/h**2). No third bound is needed.\n",
        "    eps=.5*min(1,M/(13+8/h**2))\n",
        "    Eh=(1+8/h**2)*eps\n",
        "    require(Eh<M/2,'The conservative acceleration margin is not positive')\n",
        "    def u(v):\n",
        "        r=np.abs(v)\n",
        "        return np.where(r<a1,-M*v/a1,np.where(r<=a2,-M*np.sign(v),np.where(r<2*a2,-M*np.sign(v)*(2-r/a2),0)))\n",
        "    return gamma,a1,a2,eps,Eh,u\n",
        "\n",
        "#Used to choose T3 and T4\n",
        "def duration(R,mu):\n",
        "    if not np.isfinite(R) or R<0 or not np.isfinite(mu) or mu<=0:\n",
        "        raise ValueError('Duration requires a finite R>=0 and control margin mu>0')\n",
        "    if mu>4/(3*np.sqrt(3)):\n",
        "        raise ValueError('This bound will only ensure a long enough druation if mu<=4/(3*sqrt(3))')\n",
        "    return max(6*R/mu,np.sqrt(24*R/mu))\n",
        "   # return max(1,12*R/mu,np.sqrt(4*(6*R+27/4*R**2)/mu),(27*R**3/(2*mu))**(1/3))\n",
        "\n",
        "#Used to make sure T3 and T4 are sufficiently large\n",
        "def qmoving(tau,R):return 3*R/tau+(6*R+27/4*R**2)/tau**2+27*R**3/(8*tau**3)\n",
        "\n",
        "def state_array(value,default,name):\n",
        "    raw=np.asarray(default if value is None else value)\n",
        "    if np.iscomplexobj(raw):\n",
        "        raise ValueError(f'{name} must be real-valued')\n",
        "    result=np.array(raw,dtype=float,copy=True)\n",
        "    if result.shape!=(D,) or not np.all(np.isfinite(result)):\n",
        "        raise ValueError(f'{name} must be a finite array of length {D}')\n",
        "    return result\n",
        "\n",
        "def run(M,tol=1e-10,*,x_init=None,v_init=None,target=None,\n",
        "        phase1_horizon=10000.,include_details=False):\n",
        "    gamma,a1,a2,eps,Eh,feedback=setup(M)\n",
        "    if not np.isfinite(tol) or tol<=0:\n",
        "        raise ValueError('tol must be positive and finite')\n",
        "    if not np.isfinite(phase1_horizon) or phase1_horizon<=0:\n",
        "        raise ValueError('phase1_horizon must be positive and finite')\n",
        "    xi=state_array(x_init,x0,'x_init'); vi=state_array(v_init,v0,'v_init')\n",
        "    B=state_array(target,globals()['B'],'target')\n",
        "    if np.max(np.abs(lap(B)))>=M:\n",
        "        raise ValueError('Target must satisfy max(abs(lap(target))) < M')\n",
        "    stopping_energy=eps**2/(8*max(1,4/h**2))\n",
        "    def rhs(t,y):\n",
        "        x,v=y[:D],y[D:]\n",
        "        return np.r_[v,lap(x)+f(v)+feedback(v)]\n",
        "    def event(t,y):\n",
        "        x,v=y[:D],y[D:]\n",
        "        return energy(x,v)-stopping_energy\n",
        "    event.terminal=True; event.direction=-1\n",
        "    if energy(xi,vi)<=stopping_energy:\n",
        "        # No downward crossing is needed when the stopping condition holds now.\n",
        "        sol=None; T0=0.; X0=xi.copy(); V0=vi.copy()\n",
        "    else:\n",
        "        sol=solve_ivp(rhs,(0,phase1_horizon),np.r_[xi,vi],method='DOP853',rtol=tol,atol=tol/100,\n",
        "                      max_step=.05,dense_output=True,events=event)\n",
        "        if not sol.success:\n",
        "            raise RuntimeError(f'First-phase integration failed: {sol.message}')\n",
        "        if len(sol.t_events[0])!=1:\n",
        "            raise RuntimeError(f'First-phase stopping event was not reached by {phase1_horizon}; '\n",
        "                               'this is an integration-horizon limit, not a reachability conclusion')\n",
        "        T0=sol.t_events[0][0]; X0,V0=sol.y[:D,-1],sol.y[D:,-1]\n",
        "    require(max(np.abs(V0))<eps and max(np.abs(lap(X0)))<eps,\n",
        "            'The first-phase stopping state fails the required smallness conditions')\n",
        "    braking=np.abs(V0)/eps; T1=T0+max(braking)\n",
        "    X1=X0+V0*braking-.5*eps*np.sign(V0)*braking**2 #Matches with x_l(T_1)\n",
        "    T2=T1+2/M; X2=X1+1/M#+T1/2\n",
        "    # Work with the actual position X2 at T2, rather than conflating it\n",
        "    # with the intercept X2-vb*T2 of a moving flock.\n",
        "    collapse_position_at_T2=float(np.mean(X2))\n",
        "    d_collapse=collapse_position_at_T2-X2\n",
        "    R_collapse=max(np.abs(d_collapse)); mu_collapse=M-Eh\n",
        "    tau_collapse=duration(R_collapse,mu_collapse); T3=T2+tau_collapse\n",
        "    X3=np.full(D,collapse_position_at_T2+tau_collapse)\n",
        "    d_target=B-X3+T3\n",
        "    R_target=max(np.abs(d_target)); mu_target=M-max(np.abs(lap(B)))\n",
        "    print(R_target)\n",
        "    tau_target=duration(R_target,mu_target); T4=T3+tau_target; T=T4\n",
        "    #shift=collapse_position_at_T2-vb*T2-target_center\n",
        "    def plan(t,phase=None):\n",
        "        if phase is None:\n",
        "            phase=(0 if t<T0 else 1 if t<T1 else 2 if t<T2\n",
        "                   else 3 if t<T3 else 4 if t<T4 else 5)\n",
        "        if phase==0:\n",
        "            y=np.r_[xi,vi] if sol is None else sol.sol(t)\n",
        "            x,v=y[:D],y[D:]; u=feedback(v)\n",
        "        elif phase==1:\n",
        "            z=t-T0; r1=np.minimum(z,braking)\n",
        "            x=X0+V0*r1-.5*eps*np.sign(V0)*r1**2   #Matches eq below 2.14\n",
        "            v=np.sign(V0)*np.maximum(np.abs(V0)-eps*z,0) #Matches 2.14\n",
        "            dv=np.where(z<braking,-eps*np.sign(V0),0) #dot(v)\n",
        "            u=dv-lap(x)-f(v) #Matches 2.13\n",
        "        elif phase==2:\n",
        "            # z is elapsed time, so x(T1)=X1 AND v(T1)=0.\n",
        "            # X1 + M/4*(t*t-T1*T1) would have the wrong derivative.\n",
        "            z=t-T1; x=X1+M/4*z*z; v=np.full(D,M/2*z)\n",
        "            u=M/2-lap(X1)-f(v)\n",
        "        elif phase==3:\n",
        "            s=np.clip((t-T2)/tau_collapse,0,1); p=3*s*s-2*s**3\n",
        "            dp=6*s*(1-s); ddp=6-12*s\n",
        "            x=X2+(t-T2)+p*d_collapse\n",
        "            v=1+d_collapse/tau_collapse*dp #Matches middle of pg 14\n",
        "            #u=-(1+2*s**3-3s**2)*lap(X2)+12/tau_collapse*d_collapse*s(1-6)\n",
        "            u=d_collapse/tau_collapse**2*ddp-lap(x)-f(v) #Good\n",
        "        elif phase==4:\n",
        "            s=np.clip((t-T3)/tau_target,0,1); p=3*s*s-2*s**3\n",
        "            dp=6*s*(1-s); ddp=6-12*s\n",
        "            x=X3+(t-T3)+p*d_target\n",
        "            v=1+d_target/tau_target*dp\n",
        "            u=d_target/tau_target**2*ddp-lap(x)-f(v)\n",
        "        elif phase==5:\n",
        "            x=X3+(t-T3)+d_target; v=np.full(D,1); u=-lap(B)\n",
        "        else:\n",
        "            raise ValueError('phase must be an integer from 0 through 5')\n",
        "        return x,v,u\n",
        "    chunks=[]\n",
        "    for phase,(lo,hi,count) in enumerate([(0,T0,max(2000,int(T0/.01))),(T0,T1,600),(T1,T2,600),(T2,T3,600),(T3,T4,600),(T4,T4+20,200)]):\n",
        "        tt=np.linspace(lo,hi,count if hi>lo else 1)\n",
        "        dat=np.array([np.concatenate(plan(t,phase)) for t in tt])\n",
        "        chunks.append((tt,dat,phase))\n",
        "    maxtotal=max(np.max(np.abs(d[:,2*D:])) for t,d,p in chunks)\n",
        "    maxlate=max(np.max(np.abs(d[:,2*D:])) for t,d,p in chunks if p>0)\n",
        "    # Separate integration of the exact planned controls for the short later phases.\n",
        "    #I believe this is used as a check to make sure everything is working correctly.\n",
        "    y=np.r_[X0,V0]; errors=[]; endpoint_errors=[]\n",
        "    boundaries=sorted(set([T0,*list(T0+braking),T1,T2,T3,T4]))\n",
        "    for lo,hi in zip(boundaries[:-1],boundaries[1:]):\n",
        "        if hi-lo<1e-13:continue\n",
        "        phase=(1 if (lo+hi)/2<T1 else 2 if (lo+hi)/2<T2\n",
        "               else 3 if (lo+hi)/2<T3 else 4)\n",
        "        active=((lo+hi)/2-T0)<braking\n",
        "        def later(t,y):\n",
        "            xr,vr,u=plan(t,phase)\n",
        "            if phase==1:\n",
        "                # Fix the active set on this open interval: solve_ivp must\n",
        "                # see its one-sided acceleration also at the interval ends.\n",
        "                u=-eps*np.sign(V0)*active-lap(xr)-f(vr)\n",
        "            return np.r_[y[D:],lap(y[:D])+f(y[D:])+u]\n",
        "        z=solve_ivp(later,(lo,hi),y,method='DOP853',rtol=tol,atol=tol/100,\n",
        "                    max_step=.01,dense_output=True)\n",
        "        if not z.success:raise RuntimeError(z.message)\n",
        "        y=z.y[:,-1]\n",
        "        ref=np.concatenate(plan(hi,phase)[:2]); endpoint_errors.append(max(np.abs(y-ref)))\n",
        "        check_times=np.unique(np.r_[z.t,(z.t[:-1]+z.t[1:])/2])\n",
        "        refs=np.array([np.concatenate(plan(t,phase)[:2]) for t in check_times]).T\n",
        "        errors.append(float(np.max(np.abs(z.sol(check_times)-refs))))\n",
        "\n",
        "    # Check the requested intermediate state and all switching states,\n",
        "    # independently of the separate ODE replay above. Controls may jump.\n",
        "    switch_jumps=[]\n",
        "    for phase,t in enumerate([T0, T1, T2, T3, T4]):\n",
        "        left=np.concatenate(plan(t,phase)[:2])\n",
        "        right=np.concatenate(plan(t,phase+1)[:2])\n",
        "        switch_jumps.append(max(np.abs(left-right)))\n",
        "    xc,vc,_=plan(T3,3)\n",
        "    xt,vt,_=plan(T4,4)\n",
        "    collapse_spread=float(np.ptp(xc))\n",
        "    collapse_velocity_error=float(max(abs(1-vc)))\n",
        "    Q_collapse=qmoving(tau_collapse,R_collapse)\n",
        "    Q_target=qmoving(tau_target,R_target)\n",
        "    require(max(switch_jumps)<1e-10,'Position or velocity jumps at a switch')\n",
        "    require(Q_collapse<mu_collapse and Q_target<mu_target,'A final-stage control margin failed')\n",
        "    require(max(errors)<1e-7,'Planned controls fail the sampled ODE replay')\n",
        "    require(maxtotal<=M+1e-10,'A sampled control exceeds M')\n",
        "    require(max(np.abs(lap(X1)))<Eh,'The propagated Laplacian bound failed')\n",
        "    result=dict(M=M,epsilon=eps,Eh=Eh,T0=T0,T1=T1,T2=T2,T3=T3,T4=T4,T=T,\n",
        "                tau_collapse=tau_collapse,tau_target=tau_target,\n",
        "                R_collapse=R_collapse,R_target=R_target,\n",
        "                mu_collapse=mu_collapse,mu_target=mu_target,\n",
        "                Q_collapse=Q_collapse,Q_target=Q_target,#target_shift=shift,\n",
        "                collapse_spread=collapse_spread, #This ensures that everything collapses to the same point\n",
        "                collapse_velocity_error=collapse_velocity_error,\n",
        "                #target_translation_error=target_translation_error,target_velocity_error=target_velocity_error,\n",
        "                max_switch_state_jump=max(switch_jumps),\n",
        "                max_control=maxtotal,max_later_control=maxlate,\n",
        "                lap_after_braking=max(np.abs(lap(X1))),ode_check=max(errors),\n",
        "                ode_endpoint_check=max(endpoint_errors),\n",
        "                stopping_energy=stopping_energy,first_phase_final_energy=energy(X0,V0),\n",
        "                chunks=chunks,final_state=y)\n",
        "    result['details']=dict(plan=plan,first_phase_solution=sol,X0=X0,V0=V0,\n",
        "                               X1=X1,X2=X2,X3=X3,braking=braking,target=B,\n",
        "                               initial_x=xi,initial_v=vi,boundaries=boundaries)\n",
        "    return result"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
