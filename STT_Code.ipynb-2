          "text": [
            "24.20784460392697\n",
            "42.22372656195794\n",
            "threshold 0.002 T 3331.8713458556763 bound\n",
            "41.91371256178843\n",
            "threshold 0.005 T 3259.193415307805 bound\n",
            "41.43804094825345\n",
            "threshold 0.01 T 3145.8154048667925 bound\n",
            "40.52145983337668\n",
            "threshold 0.02 T 2937.1133643382236 bound\n",
            "38.16292356903368\n",
            "threshold 0.05 T 2436.501573212765 bound\n",
            "35.276816842098995\n",
            "threshold 0.1 T 1880.6860920349357 bound\n",
